// App icon and the file details Windows shows in Properties → Details.
#include <winver.h>

1 ICON "FootageRecord.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Footage Record"
            VALUE "FileDescription", "Footage Record screen recorder"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "FootageRecord"
            VALUE "LegalCopyright", "Copyright 2026 Footage Record"
            VALUE "OriginalFilename", "FootageRecord.exe"
            VALUE "ProductName", "Footage Record"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
